{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porta",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "porta.xona-agent.com", "custom_domain": true }],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "porta",
      "database_id": "5cf1cf21-623c-41ac-8190-d79bc3241bf1"
    }
  ],
  "triggers": {
    // Engine cycle: every 30 minutes. Each cycle is one DCA decision pass.
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    // Trades are simulated until DRY_RUN is set to "false" as a secret/var.
    "DRY_RUN": "false",
    "SIGNAL_API_BASE": "https://api.xona-agent.com",
    // Skip buys when the xStock trades this far above its underlying (percent).
    "MAX_PREMIUM_PCT": "1.5",
    "SLIPPAGE_BPS": "100",
    "PRIVY_APP_ID": "cmriuk72e00100dkym2vzsn5d",
    "DEMO_USER_ID": "cb88e0be-2058-4e13-8034-1f81ae641a72"
  }
  // Secrets (set with `wrangler secret put`):
  //   MASTER_KEY      32 bytes base64; encrypts per-user agent wallet secrets
  //   ADMIN_TOKEN     optional; locks POST /api/cycle/run
  //   SOLANA_RPC_URL  optional, defaults to public mainnet RPC
}
